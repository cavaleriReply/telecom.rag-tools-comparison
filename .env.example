# Vertex AI (Gemini) — credenziali
VERTEXAI_PROJECT="prj-xxxxxxxx"
VERTEXAI_LOCATION="europe-west1"
GOOGLE_APPLICATION_CREDENTIALS=/percorso/della/service-account.json

# Modelli condivisi da tutti i framework (via litellm)
LLM_MODEL="vertex_ai/gemini-2.5-flash"
EMBEDDING_MODEL="vertex_ai/gemini-embedding-001"

# --- supermemory ---
# Hosted:      SUPERMEMORY_API_KEY="sm_..."
# Self-hosted: SUPERMEMORY_BASE_URL="http://localhost:6767"
#   Il binario va lanciato a parte (vedi scripts/supermemory_local.sh e docs/supermemory.md)
#   configurato per usare gemini-embedding-001 + gemini-2.5-flash.
SUPERMEMORY_BASE_URL="http://localhost:6767"
